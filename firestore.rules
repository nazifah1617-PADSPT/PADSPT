rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Relational checks to allow admins from Firestore collection
    function isPreApprovedSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email.lower() == "photonazifah1617@gmail.com") ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.token.email.lower())) && 
         get(/databases/$(database)/documents/admin_users/$(request.auth.token.email.lower())).data.role == 'SUPER_ADMIN')
      );
    }

    function isPreApprovedAdmin() {
      return isAuthenticated() && (
        isPreApprovedSuperAdmin() || 
        request.auth.token.email.lower() == "admin@penang.gov.my" ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.token.email.lower())) && 
         get(/databases/$(database)/documents/admin_users/$(request.auth.token.email.lower())).data.role == 'ADMIN')
      );
    }

    function isSuperAdmin() {
      return isPreApprovedSuperAdmin();
    }

    function isAdmin() {
      return isPreApprovedAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN')
      );
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /admin_users/{email} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /jk_records/{recordId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /jk_surau_records/{recordId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /surau_records/{recordId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /masjid_records/{recordId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /pegawai_records/{recordId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /pembaikan_records/{recordId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /document_records/{recordId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
