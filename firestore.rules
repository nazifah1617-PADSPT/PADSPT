rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isPreApprovedSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == "photonazifah1617@gmail.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.token.email)) && 
         get(/databases/$(database)/documents/admin_users/$(request.auth.token.email)).data.role == 'SUPER_ADMIN')
      );
    }

    function isPreApprovedAdmin() {
      return isAuthenticated() && (
        isPreApprovedSuperAdmin() ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.token.email)) && 
         get(/databases/$(database)/documents/admin_users/$(request.auth.token.email)).data.role == 'ADMIN')
      );
    }

    function isSuperAdmin() {
      return isPreApprovedSuperAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN'
      );
    }

    function isAdmin() {
      return isPreApprovedAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
      );
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      allow create: if isAuthenticated() && (request.auth.uid == userId) && (
        (request.resource.data.role == 'USER') || 
        (request.resource.data.role == 'ADMIN' && isPreApprovedAdmin()) ||
        (request.resource.data.role == 'SUPER_ADMIN' && isPreApprovedSuperAdmin())
      );
      allow update: if isSuperAdmin() || (request.auth.uid == userId && (
        (request.resource.data.role == resource.data.role) ||
        (request.resource.data.role == 'ADMIN' && isPreApprovedAdmin()) ||
        (request.resource.data.role == 'SUPER_ADMIN' && isPreApprovedSuperAdmin())
      ));
      allow delete: if isSuperAdmin();
    }

    match /admin_users/{email} {
      allow read: if isAuthenticated() && (isAdmin() || request.auth.token.email == email);
      allow write: if isSuperAdmin();
    }

    match /jk_records/{recordId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /jk_surau_records/{recordId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /surau_records/{recordId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /masjid_records/{recordId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /pegawai_records/{recordId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable
    }
  }
}
