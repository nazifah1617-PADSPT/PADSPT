{
  "entities": {
    "JKRecord": {
      "title": "Jawatankuasa Kariah Record",
      "description": "Maklumat lengkap ahli Jawatankuasa Kariah Masjid.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ID" },
        "namaPenuh": { "type": "string", "description": "Nama penuh mengikut KP" },
        "noKP": { "type": "string", "description": "No Kad Pengenalan (Encrypted)" },
        "noTel": { "type": "string", "description": "No Telefon (Encrypted)" },
        "alamat": { "type": "string", "description": "Alamat kediaman" },
        "tarikhLahir": { "type": "string", "format": "date", "description": "Tarikh lahir" },
        "pekerjaan": { "type": "string", "description": "Pekerjaan" },
        "umur": { "type": "integer", "description": "Umur" },
        "masjidName": { "type": "string", "description": "Nama Masjid" },
        "masjidKod": { "type": "string", "description": "Kod Masjid" },
        "daerah": { "type": "string", "description": "Daerah" },
        "parlimen": { "type": "string", "description": "Parlimen" },
        "dun": { "type": "string", "description": "DUN" },
        "jawatan": { "type": "string", "description": "Jawatan (e.g. Pengerusi, AJK)" },
        "tarikhLantikan": { "type": "string", "format": "date", "description": "Tarikh lantikan" },
        "tarikhTamat": { "type": "string", "format": "date", "description": "Tarikh tamat" },
        "statusLantikan": { 
          "type": "string", 
          "enum": ["Aktif", "Tamat tempoh", "Letak jawatan", "Digantung", "Meninggal dunia"],
          "description": "Status semasa jawatan"
        },
        "noSuratLantikan": { "type": "string", "description": "No surat lantikan rasmi" },
        "lampiranUrl": { "type": "string", "description": "URL fail lampiran lantikan" },
        "updatedBy": { "type": "string", "description": "UID pegawai yang mengemaskini" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Tarikh kemaskini terakhir" }
      },
      "required": ["namaPenuh", "noKP", "masjidName", "jawatan", "statusLantikan"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Rekod aktiviti sistem yang tidak boleh diubah (Immutable).",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID pengguna" },
        "userEmail": { "type": "string", "description": "Email pengguna" },
        "action": { "type": "string", "description": "Tindakan (LOGIN, UPLOAD, EDIT, DELETE)" },
        "details": { "type": "string", "description": "Butiran tindakan" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Masa tindakan" },
        "ipAddress": { "type": "string", "description": "Alamat IP" }
      },
      "required": ["userId", "action", "timestamp"]
    },
    "SurauRecord": {
      "title": "Surau/Masjid Record",
      "description": "Maklumat lokasi dan pengurusan Surau atau Masjid.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama": { "type": "string" },
        "kod": { "type": "string" },
        "daerah": { "type": "string" },
        "parlimen": { "type": "string" },
        "dun": { "type": "string" },
        "alamat": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nama", "kod", "daerah"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Maklumat pengguna sistem (Admin/Super Admin).",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "SUPER_ADMIN"] },
        "name": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "PembaikanRecord": {
      "title": "Rekod Pembaikan",
      "description": "Maklumat pembaikan masjid atau surau.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tajuk": { "type": "string", "description": "Tajuk Pembaikan" },
        "tarikhTerima": { "type": "string", "format": "date", "description": "Tarikh Terima" },
        "tarikhHantar": { "type": "string", "format": "date", "description": "Tarikh hantar ke JHEAIPP" },
        "catatan": { "type": "string", "description": "Catatan" },
        "failUrl": { "type": "string", "description": "URL fail PDF lampiran" },
        "masjidSurauId": { "type": "string", "description": "ID Masjid atau Surau" },
        "masjidSurauName": { "type": "string", "description": "Nama Masjid atau Surau" },
        "jenis": { "type": "string", "enum": ["Masjid", "Surau"], "description": "Jenis Premis" },
        "bulan": { "type": "integer", "description": "Bulan (1-12)" },
        "tahun": { "type": "integer", "description": "Tahun" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tajuk", "tarikhTerima", "masjidSurauName", "jenis"]
    }
  },
  "firestore": {
    "/jk_records": {
      "schema": "JKRecord",
      "description": "Koleksi utama data Jawatankuasa Kariah."
    },
    "/jk_surau_records": {
      "schema": "JKRecord",
      "description": "Koleksi utama data Jawatankuasa Surau."
    },
    "/surau_records": {
      "schema": "SurauRecord",
      "description": "Koleksi utama data Surau."
    },
    "/masjid_records": {
      "schema": "SurauRecord",
      "description": "Koleksi utama data Masjid."
    },
    "/pegawai_records": {
      "schema": "JKRecord",
      "description": "Koleksi utama data Pegawai Masjid (menggunakan skema yang sama dengan JK)."
    },
    "/audit_logs": {
      "schema": "AuditLog",
      "description": "Koleksi log audit sistem."
    },
    "/users": {
      "schema": "UserProfile",
      "description": "Koleksi profil pengguna sistem."
    },
    "/admin_users": {
      "schema": "UserProfile",
      "description": "Koleksi pengguna yang telah diluluskan untuk menjadi Admin/Super Admin (Pre-approved)."
    },
    "/test": {
      "schema": "object",
      "description": "Koleksi untuk ujian sambungan Firestore (Diagnostic)."
    },
    "/pembaikan_records": {
      "schema": "PembaikanRecord",
      "description": "Koleksi rekod pembaikan masjid dan surau."
    }
  }
}
